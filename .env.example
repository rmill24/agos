# Backend environment configuration

# Copy this file to the backend's .env and replace placeholder values.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL

DATABASE_URL=postgresql://agos_user:change_me@localhost:5432/agos?schema=public

# Use a long, random, private value. Never commit the real secret.

SESSION_SECRET=replace_with_a_long_random_secret

# Loyverse (read-only integration)

LOYVERSE_ACCESS_TOKEN=

# AI provider: groq or gemini

AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Render-hosted Gotenberg service base URL
GOTENBERG_BASE_URL=https://your-gotenberg-service.onrender.com
GOTENBERG_USERNAME=your_username
GOTENBERG_PASSWORD=your_strong_password
