# AGOS local development environment
# Copy to .env in the Laravel project root. Never commit .env.

APP_NAME=AGOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agos
DB_USERNAME=agos_user
DB_PASSWORD=change_me

# Laravel session, cache, and queue
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Local mail testing; reset links are written to the Laravel log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="agos@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Business-facing timezone; persist timestamps in UTC
BUSINESS_TIMEZONE=Asia/Manila

# Loyverse POS. List authorized Team IDs, then supply one set per ID.
LOYVERSE_TEAM_IDS=
LOYVERSE_TEAM_1_ACCESS_TOKEN=
LOYVERSE_TEAM_1_MERCHANT_ID=
LOYVERSE_TEAM_1_STORE_ID=
LOYVERSE_TEAM_1_COLLECTED_METHOD_IDS=

# AI provider: groq or gemini
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Render-hosted Gotenberg; backend only
GOTENBERG_BASE_URL=https://your-gotenberg-service.onrender.com
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
GOTENBERG_TIMEOUT=20

# PDF queue limits (enforced by AGOS application code)
PDF_QUEUE=pdf
PDF_MAX_PENDING=2
PDF_JOB_TIMEOUT=60

# Vite exposes only this non-secret value to frontend assets
VITE_APP_NAME="${APP_NAME}"
